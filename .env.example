# Frontend: use the full API base, INCLUDING /api. Development may leave this blank
# when Vite proxies /api to localhost:8000. Never expose server secrets as VITE_*.
VITE_API_URL=

# Local server: codes are intentionally returned only in development mode.
FUTVR_ENV=development
FUTVR_DATA_DIR=.futvr-data
FUTVR_PUBLIC_API_URL=http://localhost:8000
FUTVR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FUTVR_JOB_BACKEND=local
RFDETR_ENABLED=0
# Optional: force cpu during local validation; omit to let RF-DETR choose.
# RFDETR_DEVICE=cpu
# Optional: reuse an existing trusted official Large checkpoint.
# RFDETR_WEIGHTS_PATH=/absolute/path/to/rf-detr-large-2026.pth

# Production server/Modal secret only. Set FUTVR_ENV=production,
# FUTVR_JOB_BACKEND=modal, exact deployed frontend CORS origin.
# Omit FUTVR_PUBLIC_API_URL in production (do not copy the local HTTP value).
# Production signs source URLs through Supabase; its API origin is not required
# before Modal's first deployment. If explicitly set, it must use HTTPS.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=futvr-private
# Deprecated aliases remain supported for existing projects:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
